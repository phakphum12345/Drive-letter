# Production API image for Research OS Cloud + Local.
# Build from the repository root:
#   docker build -f deploy/cloud/Dockerfile.api -t research-os-api:local .
FROM python:3.12.8-slim
WORKDIR /app
COPY tools/research_os_api/contract-requirements.txt tools/research_os_api/cloud-local-requirements.txt /tmp/requirements/
RUN python -m pip install --no-cache-dir --disable-pip-version-check \
      -r /tmp/requirements/contract-requirements.txt \
      -r /tmp/requirements/cloud-local-requirements.txt
COPY . /app
RUN python -m compileall -q tools/research_os_api tools/research_curator \
    && python -m unittest discover -s tools/research_os_api -p "test_cloud_local_*.py" -v
RUN useradd --system --uid 10001 --create-home --shell /usr/sbin/nologin researchos \
    && mkdir -p /var/lib/research-os \
    && chown -R researchos:researchos /var/lib/research-os
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOST=0.0.0.0 \
    PORT=8080 \
    RESEARCH_OS_RUNTIME_MODE=cloud \
    RESEARCH_OS_DATA_DIR=/var/lib/research-os
USER 10001:10001
EXPOSE 8080
VOLUME ["/var/lib/research-os"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.getenv('PORT','8080')+'/health',timeout=3).read()"
CMD ["python", "tools/research_os_api/render_server.py"]
