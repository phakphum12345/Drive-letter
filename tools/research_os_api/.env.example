# Installed Windows Local Mode defaults to Ollama; Render Cloud Mode selects Gemini.
# Use mock only for explicit development/test runs.
RESEARCH_OS_PROVIDER=mock

# Local Ollama (OpenAI-compatible HTTP endpoint; no API key required)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:3b

# OpenAI-compatible or local endpoint
RESEARCH_OS_OPENAI_ENDPOINT=http://localhost:11434/v1/chat/completions
RESEARCH_OS_OPENAI_MODEL=local-model
# RESEARCH_OS_OPENAI_API_KEY=

# Anthropic
# RESEARCH_OS_ANTHROPIC_API_KEY=
# RESEARCH_OS_ANTHROPIC_MODEL=
# RESEARCH_OS_ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages

# Email OTP via Resend HTTPS API (no SMTP ports required)
# RESEARCH_OS_EMAIL_API_KEY=re_xxxxxxxxx
# RESEARCH_OS_EMAIL_PROVIDER=resend
# RESEARCH_OS_EMAIL_FROM=Research OS <auth@your-verified-domain.example>
# RESEARCH_OS_OWNER_EMAILS=owner@example.com

# Canonical HTTPS origin used by Google OAuth callbacks and QR pairing
# RESEARCH_OS_API_BASE_URL=https://your-authorized-tailnet-host
# RESEARCH_OS_SESSION_SECRET=generate-a-long-random-session-signing-secret
# RESEARCH_OS_EMAIL_OTP_SECRET=generate-a-long-random-otp-hmac-secret

# Gemini
# RESEARCH_OS_GEMINI_API_KEY=
# RESEARCH_OS_GEMINI_MODEL=
# RESEARCH_OS_GEMINI_ENDPOINT_TEMPLATE=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
