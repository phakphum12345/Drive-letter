{
  "version": "2.0",
  "owner": {
    "user_id": "owner",
    "role": "owner",
    "services": [
      "research_os_api",
      "team_engineering",
      "friend_internal",
      "developer_api"
    ],
    "friend_service": "internal-only"
  },
  "service_boundaries": {
    "research_os_api": "workspace",
    "team_engineering": "team-engineering",
    "friend_internal": "friend-internal",
    "developer_api": "developer-access"
  },
  "runtime_endpoint_registry": {
    "research_os_api": "%ProgramData%\\ResearchOS\\runtime\\api.json",
    "friend_internal": "%ProgramData%\\ResearchOS\\runtime\\friend.json",
    "team_engineering": "RESEARCH_OS_V3_DATA_DIR\\service.json",
    "developer_api": "%ProgramData%\\\\ResearchOS\\\\runtime\\\\developer.json"
  },
  "port_policy": "OS-assigned ephemeral loopback ports; consumers must discover the current endpoint from the owning service registry",
  "team_context": [
    "chat",
    "agents",
    "memory",
    "files",
    "tasks"
  ],
  "authorization_rule": "identity -> role -> team -> permission; port is not identity"
}
