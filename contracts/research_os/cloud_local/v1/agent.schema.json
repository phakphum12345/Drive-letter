{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.research-os.local/cloud-local/v1/agent.schema.json",
  "title": "Research OS Local Agent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "agent_id",
    "owner_id",
    "device_id",
    "protocol_versions",
    "capabilities",
    "lifecycle_state",
    "os_name",
    "agent_version",
    "registered_at"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+$"
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "lifecycle_state": {
      "enum": [
        "UNENROLLED",
        "ENROLLING",
        "ACTIVE",
        "DEGRADED",
        "OFFLINE",
        "REVOKED"
      ]
    },
    "os_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "os_version": {
      "type": "string",
      "maxLength": 128
    },
    "agent_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "last_heartbeat_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
