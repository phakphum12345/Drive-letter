{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.research-os.local/cloud-local/v1/checkpoint.schema.json",
  "title": "Research OS Cloud Local Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "checkpoint_id",
    "job_id",
    "owner_id",
    "stage_id",
    "source_sha",
    "workflow_state",
    "next_action",
    "evidence_refs",
    "created_at",
    "created_by"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "stage_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_sha": {
      "type": "string",
      "pattern": "^([a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
    },
    "workflow_state": {
      "enum": [
        "ACTIVE",
        "PAUSED",
        "BLOCKED",
        "DEFERRED",
        "COMPLETED"
      ]
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "workflow_context": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 2,
      "properties": {
        "completed": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "pending": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "supersedes_checkpoint_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "artifact_hashes": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{64}$"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
