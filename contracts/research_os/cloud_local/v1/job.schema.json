{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.research-os.local/cloud-local/v1/job.schema.json",
  "title": "Research OS Cloud Local Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "correlation_id",
    "created_at",
    "actor",
    "owner_id",
    "job_id",
    "execution_mode",
    "status",
    "task_type",
    "required_capabilities",
    "data_classification",
    "idempotency_key",
    "input_refs",
    "output_refs",
    "policy_decision_id",
    "attempt"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_sha": {
      "type": "string",
      "pattern": "^([a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "execution_mode": {
      "enum": [
        "CLOUD",
        "LOCAL",
        "HYBRID",
        "AUTO"
      ]
    },
    "status": {
      "enum": [
        "QUEUED",
        "ASSIGNED",
        "RUNNING",
        "CHECKPOINTING",
        "WAITING_FOR_LOCAL_AGENT",
        "RETRY_WAIT",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "task_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
    },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "data_classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "LOCAL_ONLY"
      ]
    },
    "assigned_worker_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "stage_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "lease_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "lease_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "checkpoint_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "input_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_ref"
      }
    },
    "output_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_ref"
      }
    },
    "policy_decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "data_classification": {
            "const": "LOCAL_ONLY"
          }
        },
        "required": [
          "data_classification"
        ]
      },
      "then": {
        "properties": {
          "execution_mode": {
            "enum": [
              "LOCAL",
              "HYBRID"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "CLOUD"
          }
        },
        "required": [
          "execution_mode"
        ]
      },
      "then": {
        "properties": {
          "data_classification": {
            "not": {
              "const": "LOCAL_ONLY"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_type",
        "principal_id"
      ],
      "properties": {
        "principal_type": {
          "enum": [
            "user",
            "service",
            "agent"
          ]
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "maxLength": 128
        },
        "data_classification": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "CONFIDENTIAL",
            "LOCAL_ONLY"
          ]
        }
      }
    }
  }
}
